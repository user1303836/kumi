{
  "description": "Work with a plug-in (Serum 2, Vital, Ozone, Pro-Q 4, Saturn 2, OTT, Supermassive, Decapitator, Pigments, Pro-L 2, or any other) the way its owner would. Read its guide before working on one. guide: what Kumi knows of it (its architecture, sound-design moves, what isn't a knob and how to get there), matched to its real parameter names, which of them Kumi can turn now (set those with set_device_parameter by name, in the plug-in's own units: \"800 Hz\", \"-6 dB\"), and how to get to the rest. wavetable: make a wavetable (keyframes of harmonics or shapes morphing frame to frame, or single cycles cut from a held note) into the plug-in's own wavetable folder, for its oscillator's menu.",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "device",
      "action"
    ],
    "properties": {
      "device": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "description": "The plug-in device (its deviceRef from this turn)"
      },
      "action": {
        "type": "string",
        "enum": [
          "guide",
          "wavetable"
        ]
      },
      "wavetable": {
        "type": "object",
        "additionalProperties": false,
        "description": "For action wavetable",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48,
            "description": "What to call it, as it shows in the synth's menu"
          },
          "keyframes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "description": "Frames it morphs through, first to last",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "harmonics": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 512,
                  "items": {
                    "type": "number"
                  },
                  "description": "Amplitudes of harmonics 1, 2, 3… (negative flips one)"
                },
                "shape": {
                  "type": "string",
                  "enum": [
                    "sine",
                    "saw",
                    "square",
                    "triangle",
                    "pulse"
                  ]
                },
                "width": {
                  "type": "number",
                  "minimum": 0.01,
                  "maximum": 0.99,
                  "description": "A pulse's width"
                }
              }
            }
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256,
            "description": "Frames in all (morphing between keyframes); 64 for a sound cut from audio"
          },
          "from_audio": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file"
            ],
            "description": "Cut single cycles from a held note instead",
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "start": {
                "type": "number",
                "minimum": 0
              },
              "seconds": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 60
              }
            }
          }
        }
      }
    }
  }
}
