t/guide/logicpro/tracks-area-key-commands-lgcp77778888/mac' id='toc-item-LGCP77778888' data-tocid='LGCP77778888'\n>\n<span class='name'>Tracks area key commands</span>\n</a>\n</li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>\n</li>\n<li>\n<button\n class='section'\n aria-expanded='false'\n onClick=''\n>\n<span class='name'>Logic Pro Effects</span>\n</button>\n<ul id='node-children-X' class='non-leaf-node-children'>\n<li>\n<button\n class='section'\n aria-expanded='false'\n onClick=''\n>\n<span class='name'>Dynamics processors</span>\n</button>\n<ul id='node-children-X' class='non-leaf-node-children'>\n<li>\n<button\n class='section'\n aria-expanded='false'\n onClick=''\n>\n<span class='name'>Compressor</span>\n</button>\n<ul id='node-children-X' class='non-leaf-node-children'>\n<li>\n<a\n data-ss-analytics-link-text='Compressor main parameters' class='toc-item' href='https://guide.test/guide/logicpro/compressor-main-parameters-lgcead9636ef/mac' id='toc-item-LGCEAD9636EF' data-tocid='LGCEAD9636EF'\n>\n<span class='name'>Compressor main parameters</span>\n</a>\n</li>\n<li>\n<a\n data-ss-analytics-link-text='Extended parameters' class='toc-item' href='../extended-parameters-lgce0b2501de/mac' id='toc-item-LGCE0B2501DE'\n>\n<span class='name'>Extended parameters</span>\n</a>\n</li>\n</ul>\n</li>\n</ul>\n</li>\n<li>\n<button\n class='section'\n aria-expanded='false'\n onClick=''\n>\n<span class='name'>Equalizers</span>\n</button>\n<ul id='node-children-X' class='non-leaf-node-children'>\n<li>\n<button\n class='section'\n aria-expanded='false'\n onClick=''\n>\n<span class='name'>Channel EQ</span>\n</button>\n<ul id='node-children-X' class='non-leaf-node-children'>\n<li>\n<a\n data-ss-analytics-link-text='Extended parameters &amp; tips' class='toc-item' href='https://guide.test/guide/logicpro/extended-parameters-lgce4d903493/mac' id='toc-item-LGCE4D903493' data-tocid='LGCE4D903493'\n>\n<span class='name'>Extended parameters &amp; tips</span>\n</a>\n</li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>\n</li>\n<li>\n<a\n data-ss-analytics-link-text='Elsewhere' class='toc-item' href='https://elsewhere.test/guide/logicpro/elsewhere-lgcp00000000/mac' id='toc-item-LGCP00000000' data-tocid='LGCP00000000'\n>\n<span class='name'>Elsewhere</span>\n</a>\n</li>\n<li>\n<a\n data-ss-analytics-link-text='Quantize regions' class='toc-item' href='https://guide.test/guide/logicpro/quantize-regions-lgcpd12112da/mac' id='toc-item-LGCPD12112DA' data-tocid='LGCPD12112DA'\n>\n<span class='name'>Quantize regions</span>\n</a>\n</li>\n<li><a href='https://guide.test/guide/logicpro/glossary-cpsr9a3eb52d/mac'>Glossary</a></li>\n</ul>\n</div></div>\n<nav class='book-pagination'><a href='https://guide.test/guide/logicpro/whats-new-lgcp4a62a494/mac' class='next-link'>Next</a></nav>\n</body></html>\n",
  "https://guide.test/guide/logicpro/welcome/mac?displayMode=headless": "\n    <head>\n    <meta name=\"robots\" content=\"noindex\" />\n</head>\n<div class=\"main\" dir=ltr id=\"arabic\">\n    <div class=\"Aside apd-topic book book-content glossary Glossary\">\n        <div id='glossary-definition-section'>\n            <body dir=\"ltr\" id=\"lgcpe355f8be\" class=\"AppleTopic apd-topic dark-mode-enabled\" lang=\"en\"><a name=\"lgcpe355f8be\"></a><h1>Logic Pro User Guide</h1><p>Start here to learn what the guide holds.</p><div class=\"LinkDownload multiple\"><p><strong>Download the guides:</strong></p><p>Logic Pro User Guide: <a href=\"https://guide.test/pdf/logic-pro-guide.pdf\" class=\"URL\">PDF</a></p></div></body>\n        </div>\n    </div>\n</div>\n",
  "https://guide.test/guide/logicpro/undo-and-redo-edits-lgcp1dbd67ab/mac?displayMode=headless": "\n    <head>\n    <meta name=\"robots\" content=\"noindex\" />\n</head>\n<div class=\"main\" dir=ltr id=\"arabic\">\n    <div class=\"Aside apd-topic book book-content glossary Glossary\">\n        <div id='glossary-definition-section'>\n            <body dir=\"ltr\" id=\"lgcp1dbd67ab\" class=\"AppleTopic apd-topic dark-mode-enabled\" lang=\"en\"><a name=\"lgcp1dbd67ab\"></a><h1>Undo and redo edits in Logic Pro for Mac</h1><p>Most edits can be undone, one step at a time, and the Undo History lists them.</p><div id=\"lgcpb9979898\" class=\"Task\"><h2 role=\"button\" aria-controls=\"aria-lgcpb9979898\" aria-expanded=\"true\" class=\"Name\">Undo the last edit</h2><div class=\"TaskBody\" role=\"region\" aria-hidden=\"false\" id=\"aria-lgcpb9979898\"><ul><li><p>Choose Edit &gt; Undo, or press Command-Z.</p></li></ul></div></div><div id=\"lgcp9f3dd21d\" class=\"Task\"><h2 role=\"button\" aria-controls=\"aria-lgcp9f3dd21d\" aria-expanded=\"true\" class=\"Name\">Open the Undo History</h2><div class=\"TaskBody\" role=\"region\" aria-hidden=\"false\" id=\"aria-lgcp9f3dd21d\"><ul><li><p>Choose Edit &gt; Undo History.</p></li></ul><figure><img src=\"https://guide.test/assets/undo-history.png\" alt=\"Figure. The undo-history window.\" height=\"300\" width=\"400\" originalImageName=\"Art/undo-history.png\"></figure><p>The step that will be undone next is highlighted.</p></div></div><div class=\"LinkDownload multiple\"><p><strong>Download the guides:</strong></p><p>Logic Pro User Guide: <a href=\"https://guide.test/pdf/logic-pro-guide.pdf\" class=\"URL\">PDF</a></p></div></body>\n        </div>\n    </div>\n</div>\n",
  "https://guide.test/guide/logicpro/quantize-regions-lgcpd12112da/mac?displayMode=headless": "\n    <head>\n    <meta name=\"robots\" content=\"noindex\" />\n</head>\n<div class=\"main\" dir=ltr id=\"arabic\">\n    <div class=\"Aside apd-topic book book-content glossary Glossary\">\n        <div id='glossary-definition-section'>\n            <body dir=\"ltr\" id=\"lgcpd12112da\" class=\"AppleTopic apd-topic dark-mode-enabled\" lang=\"en\"><a name=\"lgcpd12112da\"></a><h1>Quantize regions in Logic Pro for Mac</h1><p>Quantizing moves the notes of a <a href=\"https://guide.test/guide/logicpro/aside/lgcp3d2760d2/12.3/mac/15.6\" class=\"xRef Aside\">region</a> to the nearest point of a grid.</p><p>The Quantize setting in the Region inspector applies to whole regions.</p><div id=\"lgcp1f1e9397\" class=\"Task\"><h2 role=\"button\" aria-controls=\"aria-lgcp1f1e9397\" aria-expanded=\"true\" class=\"Name\">Quantize selected regions</h2><div class=\"TaskBody\" role=\"region\" aria-hidden=\"false\" id=\"aria-lgcp1f1e9397\"><ul><li><p>Choose a grid from the Quantize pop-up menu in the Region inspector.</p><figure><img src=\"https://guide.test/assets/quantize.png\" alt=\"Figure. The quantize window.\" height=\"300\" width=\"400\" originalImageName=\"Art/quantize.png\"></figure></li></ul><p>Key commands step through the grids one at a time.</p></div></div><div id=\"lgcp22223333\" class=\"Subhead\"><h2 class=\"Name\">Audio regions</h2><p>An audio track needs a Flex mode before its regions can be quantized.</p><h3>Quantize flex markers</h3><p>White lines show where the audio was stretched to the grid.</p></div><div class=\"Alert\"><p class=\"Note\"><em>Note: </em>The grid starts where the region starts.</p></div><div class=\"LinkDownload multiple\"><p><strong>Download the guides:</strong></p><p>Logic Pro User Guide: <a href=\"https://guide.test/pdf/logic-pro-guide.pdf\" class=\"URL\">PDF</a></p></div></body>\n        </div>\n    </div>\n</div>\n",
  "https://guide.test/guide/logicpro/track-stacks-overview-lgcp9bc4b63d/mac?displayMode=headless": "\n    <head>\n    <meta name=\"robots\" content=\"noindex\" />\n</head>\n<div class=\"main\" dir=ltr id=\"arabic\">\n    <div class=\"Aside apd-topic book book-content glossary Glossary\">\n        <div id='glossary-definition-section'>\n            <body dir=\"ltr\" id=\"lgcp9bc4b63d\" class=\"AppleTopic apd-topic dark-mode-enabled\" lang=\"en\"><a name=\"lgcp9bc4b63d\"></a><h1>Logic Pro for Mac track stacks overview</h1><p><em>Track stacks</em> gather tracks under a main track of their own.</p><div id=\"lgcp92978de3\" class=\"Subhead\"><h2 class=\"Name\">Folder stacks</h2><p>A folder stack controls its subtracks as one, without changing where their audio goes.</p></div><div id=\"lgcpc434c3ac\" class=\"Subhead\"><h2 class=\"Name\">Summing stacks</h2><p>A summing stack sends its subtracks to a bus, and its main track is an aux.</p></div><div class=\"LinkDownload multiple\"><p><strong>Download the guides:</strong></p><p>Logic Pro User Guide: <a href=\"https://guide.test/pdf/logic-pro-guide.pdf\" class=\"URL\">PDF</a></p></div></body>\n        </div>\n    </div>\n</div>\n",
  "https://guide.test/guide/logicpro/live-loops-overview-lgcpf46ffc88/mac?displayMode=headless": "\n    <head>\n    <meta name=\"robots\" content=\"noindex\" />\n</head>\n<div class=\"main\" dir=ltr id=\"arabic\">\n    <div class=\"Aside apd-topic book book-content glossary Glossary\">\n        <div id='glossary-definition-section'>\n            <body dir=\"ltr\" id=\"lgcpf46ffc88\" class=\"AppleTopic apd-topic dark-mode-enabled\" lang=\"en\"><a name=\"lgcpf46ffc88\"></a><h1>Live Loops overview in Logic Pro for Mac</h1><p>The Live Loops grid plays cells of loops and patterns, column by column, in time with the project.</p><div id=\"lgcp55556666\" class=\"Task\"><h2 role=\"button\" aria-controls=\"aria-lgcp55556666\" aria-expanded=\"true\" class=\"Name\">Show the grid</h2><div class=\"TaskBody\" role=\"region\" aria-hidden=\"false\" id=\"aria-lgcp55556666\"><ul><li><p>Click the Live Loops grid button in the control bar.</p></li></ul></div></div><div class=\"LinkDownload multiple\"><p><strong>Download the guides:</strong></p><p>Logic Pro User Guide: <a href=\"https://guide.test/pdf/logic-pro-guide.pdf\" class=\"URL\">PDF</a></p></div></body>\n        </div>\n    </div>\n</div>\n",
  "https://guide.test/guide/logicpro/tracks-area-key-commands-lgcp77778888/mac?displayMode=headless": "\n    <head>\n    <meta name=\"robots\" content=\"noindex\" />\n</head>\n<div class=\"main\" dir=ltr id=\"arabic\">\n    <div class=\"Aside apd-topic book book-content glossary Glossary\">\n        <div id='glossary-definition-section'>\n            <body dir=\"ltr\" id=\"lgcp77778888\" class=\"AppleTopic apd-topic dark-mode-enabled\" lang=\"en\"><a name=\"lgcp77778888\"></a><h1>Key commands for the Tracks area in Logic Pro for Mac</h1><p>The table lists the key commands of the U.S. preset.</p><div class=\"table-wrapper\"><table data-type=\"Multicolumn\" aria-label=\"Table. Tracks area key commands\"><thead><tr><th scope=\"col\"><p class=\"TableHead\">Function</p></th><th scope=\"col\"><p class=\"TableHead\">Key command</p></th></tr></thead><tbody><tr><td><p>Split Regions/Events at Playhead</p></td><td><p>Command-T</p></td></tr><tr><td><p>Join Regions</p></td><td><p>Command-J</p></td></tr></tbody></table></div><div class=\"LinkDownload multiple\"><p><strong>Download the guides:</strong></p><p>Logic Pro User Guide: <a href=\"https://guide.test/pdf/logic-pro-guide.pdf\" class=\"URL\">PDF</a></p></div></body>\n        </div>\n    </div>\n</div>\n",
  "https://guide.test/guide/logicpro/compressor-main-parameters-lgcead9636ef/mac?displayMode=headless": "\n    <head>\n    <meta name=\"robots\" content=\"noindex\" />\n</head>\n<div class=\"main\" dir=ltr id=\"arabic\">\n    <div class=\"Aside apd-topic book book-content glossary Glossary\">\n        <div id='glossary-definition-section'>\n            <body dir=\"ltr\" id=\"lgcead9636ef\" class=\"AppleTopic apd-topic dark-mode-enabled\" lang=\"en\"><a name=\"lgcead9636ef\"></a><h1>Compressor main parameters in Logic Pro for Mac</h1><p>The middle of Compressor's window holds the controls that shape the compression.</p><div id=\"lgcef1bedf83\" class=\"Subhead\"><h2 class=\"Name\">Compressor parameters</h2><ul><li><p><em>Threshold knob and field: </em>Set the level above which the signal is reduced.</p></li><li><p><em>Ratio knob and field: </em>Set how much the signal over the threshold is reduced.</p></li><li><p><em>Knee knob and field: </em>Set how gently compression starts near the threshold: higher values give a softer knee.</p></li></ul></div><div class=\"LinkDownload multiple\"><p><strong>Download the guides:</strong></p><p>Logic Pro User Guide: <a href=\"https://guide.test/pdf/logic-pro-guide.pdf\" class=\"URL\">PDF</a></p></div></body>\n        </div>\n    </div>\n</div>\n",
  "https://guide.test/guide/logicpro/extended-parameters-lgce0b2501de/mac?displayMode=headless": "\n    <head>\n    <meta name=\"robots\" content=\"noindex\" />\n</head>\n<div class=\"main\" dir=ltr id=\"arabic\">\n    <div class=\"Aside apd-topic book book-content glossary Glossary\">\n        <div id='glossary-definition-section'>\n            <body dir=\"ltr\" id=\"lgce0b2501de\" class=\"AppleTopic apd-topic dark-mode-enabled\" lang=\"en\"><a name=\"lgce0b2501de\"></a><h1>Compressor extended parameters in Logic Pro for Mac</h1><p>The extended parameters set the side chain's filter and the output's distortion.</p><div class=\"LinkDownload multiple\"><p><strong>Download the guides:</strong></p><p>Logic Pro User Guide: <a href=\"https://guide.test/pdf/logic-pro-guide.pdf\" class=\"URL\">PDF</a></p></div></body>\n        </div>\n    </div>\n</div>\n"
 }
