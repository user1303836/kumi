on":"The Renoise process to use, from discover, when several run."},"resource":{"type":"string","description":"The Renoise resource or preferences folder to use, from discover, when several run."},"jobId":{"type":"string"}},"required":["jobId"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false}},{"name":"audition","title":"Play out loud in Renoise","description":"Plays an audio file once, out loud, where the producer listens to Renoise, without changing the project: {previewId, playing, seconds, via}. A new one stops the one playing; it stops when Renoise starts playing too.","inputSchema":{"type":"object","properties":{"pid":{"type":"integer","minimum":1,"description":"The Renoise process to use, from discover, when several run."},"resource":{"type":"string","description":"The Renoise resource or preferences folder to use, from discover, when several run."},"file":{"type":"string","description":"An absolute path."},"fromSeconds":{"type":"number","minimum":0},"seconds":{"type":"number","exclusiveMinimum":0},"gainDb":{"type":"number","minimum":-60,"maximum":12}},"required":["file"],"additionalProperties":false},"annotations":{"readOnlyHint":true,"idempotentHint":false,"openWorldHint":false}},{"name":"audition_stop","title":"Stop playing out loud","description":"Stops the file playing out loud (the one named, or whichever): {stopped}.","inputSchema":{"type":"object","properties":{"pid":{"type":"integer","minimum":1,"description":"The Renoise process to use, from discover, when several run."},"resource":{"type":"string","description":"The Renoise resource or preferences folder to use, from discover, when several run."},"previewId":{"type":"string"}},"additionalProperties":false},"annotations":{"readOnlyHint":true,"idempotentHint":true,"openWorldHint":false}},{"name":"audio_file","title":"Renoise audio file","description":"The audio a ref stands for in Renoise: {file, seconds, channels, 