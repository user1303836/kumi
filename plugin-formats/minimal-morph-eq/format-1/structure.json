  "files": {
    "preset": {
      "extension": ".xml",
      "layers": [
        "native XML"
      ],
      "constants": {
        "root": "MorphEQ"
      }
    },
    "state": {
      "layers": [
        "VST3 Comp chunk",
        "optional VstW compatibility bank",
        "VC2! + little-endian XML byte length + XML + NUL + preserved opaque JUCE private data"
      ],
      "constants": {
        "xml_magic": "VC2!",
        "root": "MorphEQ"
      }
    }
  },
  "opaque": [
    "state"
  ],
