    "parameters/MKUMorphEQNode_Main_Offset": {"type":"float","status":"guessed","default":0.0,"range":[-0.5,0.5],"range_status":"verified"},
    "parameters/MKUMorphEQNode_Main_Pinch": {"type":"float","status":"guessed","default":0.0,"range":[-1.0,1.0],"range_status":"verified"},
