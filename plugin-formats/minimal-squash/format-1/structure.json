    "parameters/MKUSquashCompressorNode_Main_Mix": {"type":"float","status":"guessed","default":1.0,"range":[0.0,1.0],"range_status":"verified"},
    "state": {"type":"map","in":["state","preset"],"status":"guessed"}
  },
  "parameters": {
    "Depth [VST3 33163679]": {"field":"parameters/MKUSquashCompressorNode_Main_Depth","status":"verified"},
    "Tone [VST3 278650646]": {"field":"parameters/MKUSquashCompressorNode_Main_Tone","status":"verified"},
