{
  "plugin": "valhalla-freq-echo",
  "format": "format-1",
  "about": "Normalized Valhalla sound controls in XML root attributes. Numeric edits require the verified intervals below. Raw XML attributes are preserved read-only and not duplicated here. Individual endpoint reload evidence is in range-verification.json.",
  "paths": "exact",
  "files": {
    "preset": {
      "extension": ".vpreset",
      "layers": [
        "native XML"
      ],
      "constants": {
        "root": "MYPLUGINSETTINGS"
      }
    },
    "state": {
      "layers": [
        "VST3 Comp chunk",
        "optional VstW compatibility bank",
        "VC2! + little-endian XML byte length + XML + NUL + preserved opaque JUCE private data"
      ],
      "constants": {
        "xml_magic": "VC2!",
        "root": "MYPLUGINSETTINGS"
      }
    }
  },
  "opaque": [
    "state"
  ],
  "fields": {
    "": {"type":"map","in":["state","preset"],"status":"guessed"},
    "root": {"type":"text","in":["state","preset"],"status":"guessed"},
    "parameters": {"type":"map","in":["state","preset"],"status":"guessed"},
    "parameters/wetDryMix": {"type":"float","status":"guessed","default":0.5,"unit":"normalized","range":[0.0,1.0],"range_status":"verified"},
