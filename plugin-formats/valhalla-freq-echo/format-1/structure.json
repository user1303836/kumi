    "parameters/delay": {"type":"float","status":"guessed","default":0.000990009866654873,"unit":"normalized","range":[0.0,1.0],"range_status":"verified"},
    "parameters/sync": {"type":"float","status":"guessed","default":0.0,"unit":"normalized","range":[0.0,1.0],"range_status":"verified"},
    "parameters/feedback": {"type":"float","status":"guessed","default":0.5,"unit":"normalized","range":[0.0,1.0],"range_status":"verified"},
    "parameters/lowCut": {"type":"float","status":"guessed","default":0.06040268391370773,"unit":"normalized","range":[0.0,1.0],"range_status":"verified"},
    "parameters/highCut": {"type":"float","status":"guessed","default":0.3311036825180054,"unit":"normalized","range":[0.0,1.0],"range_status":"verified"},
    "parameters/stereo": {"type":"float","status":"guessed","default":1.0,"unit":"normalized","range":[0.0,1.0],"range_status":"verified"},
    "state": {"type":"map","in":["state","preset"],"status":"guessed"},
    "name": {"type":"text","in":["state","preset"],"status":"guessed"}
